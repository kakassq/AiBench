{
  "id": "aibench-reel",
  "name": "AiBench Reel",
  "version": "0.1.0",
  "description": "字标起手、几何推进、卡点切镜。竖版 9:16 / 方版 1:1，每格 2 秒，字幕不超过 4 字。",
  "tracks": ["1.1", "1.4", "1.5"],
  "license": "MIT",
  "builtin": true,
  "engines": {
    "aibench": ">=0.1.0",
    "node": ">=22.19"
  },
  "capabilities": {
    "render": true,
    "voice": false,
    "subtitles": true,
    "bilingual": true
  },
  "defaults": {
    "type": 1,
    "style": 4,
    "palette": 3,
    "flow": 0,
    "durationSec": 12,
    "beatBpm": 120,
    "subtitle": "zh",
    "aspect": "9:16"
  },
  "skills": [
    {
      "id": "reel.run",
      "name": "reel-run",
      "file": "skills/reel.run/SKILL.md"
    }
  ],
  "templates": [
    {
      "id": "reel.mark",
      "file": "templates/mark.template.json",
      "title": "字标起手：三拍落版",
      "track": "1.4"
    },
    {
      "id": "reel.countdown",
      "file": "templates/countdown.template.json",
      "title": "卡点倒数：一秒一格",
      "track": "1.5"
    },
    {
      "id": "reel.feature",
      "file": "templates/feature.template.json",
      "title": "三点卖点：竖版快剪",
      "track": "1.1"
    }
  ],
  "runtime": {
    "shared": ["remotion@4", "react@19"],
    "requires": []
  }
}
